-03  5847.7515  290.97128  26.504536  1015.83514  582.38540    0.0   \n1960-01-04  5252.0586  292.20060  30.678936  1013.92230  555.11860    0.0   \n1960-01-05  3379.3190  293.06076  27.790462  1011.94934  394.95440    0.0   \n\n            wind_speed_10m  wind_speed_925hPa       U10       V10  \ntime                                                               \n1960-01-01        6.801503          13.483623 -4.671345 -4.943579  \n1960-01-02        8.316340          18.027075 -6.334070 -5.388977  \n1960-01-03        9.148216          17.995173 -6.701636 -6.227193  \n1960-01-04        8.751743          15.806478 -6.387379 -5.982842  \n1960-01-05        6.393228           9.160809 -4.238991 -4.785845  \n"}],"key":"PCJF6pcREN"}],"key":"B6qg8xiYh6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Scaling the variables using the robust scaling method","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hdTo0fSb5I"}],"identifier":"scaling-the-variables-using-the-robust-scaling-method","label":"Scaling the variables using the robust scaling method","html_id":"scaling-the-variables-using-the-robust-scaling-method","implicit":true,"key":"AO1y6hacMl"}],"key":"WO4WO1LRob"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# normalization by minmax scaling \nminmax_sc = preprocessing.MinMaxScaler(feature_range = (0, 1))\nminmax_sc.fit(dust_df)\nminmax_scaled_df = minmax_sc.transform(dust_df)\n\n# standardization\nstd_sc = preprocessing.StandardScaler().fit(dust_df)\nstd_scaled_df = std_sc.transform(dust_df)\n\n# Robust scaling for outliers\nrb_sc = preprocessing.RobustScaler().fit(dust_df)\nrob_scaled_df = rb_sc.transform(dust_df)","key":"pi3hGuBUGh"},{"type":"output","id":"GTwHhzMNpaY4Fs5ZhLeJR","data":[],"key":"hcBgUWmT3l"}],"key":"PcsRqzVC9k"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define map and train the SOM map","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mbI7FglzeU"}],"identifier":"define-map-and-train-the-som-map","label":"Define map and train the SOM map","html_id":"define-map-and-train-the-som-map","implicit":true,"key":"JLwJAdoQg8"}],"key":"G1dUoTL8O8"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The authors of SOM recommend a map size of ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JOLAnjCtTH"}],"key":"qgWcShRQIA"},{"type":"math","value":"5\\times \\sqrt{(number\\_of\\_samples)}","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"tight":true,"html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mn>5</mn><mo>×</mo><msqrt><mrow><mo stretchy=\"false\">(</mo><mi>n</mi><mi>u</mi><mi>m</mi><mi>b</mi><mi>e</mi><mi>r</mi><mi mathvariant=\"normal\">_</mi><mi>o</mi><mi>f</mi><mi mathvariant=\"normal\">_</mi><mi>s</mi><mi>a</mi><mi>m</mi><mi>p</mi><mi>l</mi><mi>e</mi><mi>s</mi><mo stretchy=\"false\">)</mo></mrow></msqrt></mrow><annotation encoding=\"application/x-tex\">5\\times \\sqrt{(number\\_of\\_samples)}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">5</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1.84em;vertical-align:-0.5861em;\"></span><span class=\"mord sqrt\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.2539em;\"><span class=\"svg-align\" style=\"top:-3.8em;\"><span class=\"pstrut\" style=\"height:3.8em;\"></span><span class=\"mord\" style=\"padding-left:1em;\"><span class=\"mopen\">(</span><span class=\"mord mathnormal\">n</span><span class=\"mord mathnormal\">u</span><span class=\"mord mathnormal\">mb</span><span class=\"mord mathnormal\" style=\"margin-right:0.02778em;\">er</span><span class=\"mord\" style=\"margin-right:0.02778em;\">_</span><span class=\"mord mathnormal\">o</span><span class=\"mord mathnormal\" style=\"margin-right:0.10764em;\">f</span><span class=\"mord\" style=\"margin-right:0.02778em;\">_</span><span class=\"mord mathnormal\">s</span><span class=\"mord mathnormal\">am</span><span class=\"mord mathnormal\" style=\"margin-right:0.01968em;\">pl</span><span class=\"mord mathnormal\">es</span><span class=\"mclose\">)</span></span></span><span style=\"top:-3.2139em;\"><span class=\"pstrut\" style=\"height:3.8em;\"></span><span class=\"hide-tail\" style=\"min-width:1.02em;height:1.88em;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width='400em' height='1.88em' viewBox='0 0 400000 1944' preserveAspectRatio='xMinYMin slice'><path d='M983 90\nl0 -0\nc4,-6.7,10,-10,18,-10 H400000v40\nH1013.1s-83.4,268,-264.1,840c-180.7,572,-277,876.3,-289,913c-4.7,4.7,-12.7,7,-24,7\ns-12,0,-12,0c-1.3,-3.3,-3.7,-11.7,-7,-25c-35.3,-125.3,-106.7,-373.3,-214,-744\nc-10,12,-21,25,-33,39s-32,39,-32,39c-6,-5.3,-15,-14,-27,-26s25,-30,25,-30\nc26.7,-32.7,52,-63,76,-91s52,-60,52,-60s208,722,208,722\nc56,-175.3,126.3,-397.3,211,-666c84.7,-268.7,153.8,-488.2,207.5,-658.5\nc53.7,-170.3,84.5,-266.8,92.5,-289.5z\nM1001 80h400000v40h-400000z'/></svg></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.5861em;\"><span></span></span></span></span></span></span></span></span></span>","enumerator":"1","key":"Wq0HzMf4FG"},{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":" See a full documentation of the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"psOOXJehLm"},{"type":"link","url":"https://github.com/JustGlowing/minisom/blob/master/Readme.md","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"SOM package","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"s6HPz37I0r"}],"urlSource":"https://github.com/JustGlowing/minisom/blob/master/Readme.md","data":{"kind":"file","org":"JustGlowing","repo":"minisom","reference":"master","file":"Readme.md","raw":"https://raw.githubusercontent.com/JustGlowing/minisom/master/Readme.md"},"internal":false,"protocol":"github","key":"ThBrvZHAx6"}],"key":"Y5YHICAWJH"}],"key":"b4qTTNG62j"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# training data\ntrain_data = rob_scaled_df\n# Define minisom model\nn_samples = train_data.shape[1]  # retrieves the number of sampe (10 for this cookbook) \nnum = math.ceil(5*math.sqrt(n_samples))\nsom = MiniSom(x=num,\n              y=num, # map size, NxN\n              input_len=10, # number of features used for training the model (10 element input vectors)\n              sigma=3.,     # sigma: is the radius of the different neighbors in the SOM\n              learning_rate=0.5, # learning rate: determines how much the weights are adjusted during each iterations\n              neighborhood_function='gaussian', # a few options for this\n             topology='hexagonal', \n              activation_distance='euclidean', \n              random_seed=10)\n\n# initilize weight\nsom.random_weights_init(train_data)  # random weights initialization \n#som.pca_weights_init(train_data)  # initialize weights using PCA \n\n## there are two type of training\n# 1. train_random: trains model by pickinhg random data from the data\n# 2. train_batch: trains model from samples in the order in which they are fed.\n\nsom.train(data = train_data, num_iteration = 25000, \n          verbose=True, random_order=True) # training the SOM model for 25000 iterations ","key":"Vk7TLRq5Vf"},{"type":"output","id":"2cZQ3mAZ2nHk0yYWqQfyz","data":[{"name":"stdout","output_type":"stream","text":" [ 25000 / 25000 ] 100% - 0:00:00 left \n quantization error: 0.7955823980825105\n"}],"key":"Q3DiP6vRi1"}],"key":"deeDJA0d2R"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualizing the SOM results","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RhNnv2Lt5B"}],"identifier":"visualizing-the-som-results","label":"Visualizing the SOM results","html_id":"visualizing-the-som-results","implicit":true,"key":"nBVIe5NZuN"}],"key":"z7xaVdKDYh"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Neighbour distance","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PEtvqF2G9d"}],"identifier":"neighbour-distance","label":"Neighbour distance","html_id":"neighbour-distance","implicit":true,"key":"eZwD0jHaHS"}],"key":"QMlS4ndPMr"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The neighbor distance is also known as the “U-Matrix”. It is the distance between each node and its neighbours. Regions of low neighbourhood distance indicate groups of nodes that are similar, while regions of large distances indicate nodes are much more different. The U-Matrix can be used to identify clusters within the SOM map.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Q1tP1WIzYD"}],"key":"aYzFXqXjj9"}],"key":"OHxPdWGtX1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pylab import bone, pcolor, colorbar, plot, show\nbone()\npcolor(som.distance_map().T, cmap='bone')\ncolorbar()","key":"w8jyyphMbr"},{"type":"output","id":"o9ZKnR2eXe5n7bdxcUq5v","data":[{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"fe953a94bd3cfc1bf3fcd4ba34b3b9d1","path":"/dust-cookbook/build/fe953a94bd3cfc1bf3fcd4ba34b3b9d1.png"},"text/plain":{"content":"<Figure size 960x720 with 2 Axes>","content_type":"text/plain"}}}],"key":"gpL540Vd7f"}],"key":"vTqhQV7z6r"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Feature plane","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CRk7N4oxcn"}],"identifier":"feature-plane","label":"Feature plane","html_id":"feature-plane","implicit":true,"key":"xcX2bPUCAS"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This is a map for each variable used, and it shows the magnitude of the weights associated to it for each neuron.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"L98ryhpuLR"}],"key":"iuHpHXyeUc"}],"key":"WMPhlZPUJA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"titles = ['PM10', '2m temperature', '2m relative humidity', 'Mean sea level pressure', 'Boundary layer depth', \n          'Convective rainfall', '10m wind speed', '925hPa wind speed', 'horizontal wind', 'meridional wind']\nW = som.get_weights()\nfig, ax = plt.subplots(3, 4, figsize=(16, 10))\nax = ax.flatten()\nfor i, f in enumerate(feature_names):\n    #plt.subplot(5, 2, i+1)\n    ax[i].set_title(titles[i])\n    ax[i].pcolor(W[:,:,i].T, cmap='coolwarm')\n    #ax[i].set_xticks(np.arange(num+1))\n    #ax[i].set_yticks(np.arange(num+1))\nax[10].set_axis_off()\nax[11].set_axis_off()\nplt.tight_layout()\nplt.savefig('feature_patterns.png')","key":"ayIW64v4AF"},{"type":"output","id":"PkqlzzoR6_VvyJkvXWDtc","data":[{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"5d2102f57983106fb8c2567edbd0079a","path":"/dust-cookbook/build/5d2102f57983106fb8c2567edbd0079a.png"},"text/plain":{"content":"<Figure size 2400x1500 with 12 Axes>","content_type":"text/plain"}}}],"key":"RKISHePAkb"}],"key":"eiZnPy6pE0"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"We see a pattern which establishes the relationship between each of the variables under consideration.\nFor example, nodes of higher PM10 concentration are associated with nodes of higher 10m wind speed and 925hPa wind speed and vice versa. The horizontal and meridional wind patterns suggest a prevailing northeasterly trade winds, which are known to be associated with dust emissions and transport. Regions of high PM10 concentration correspond to somewhat lower temperatures, which may be expected, but more diurnal scale analysis is need to verify this statement. The analysis also reveals that increased dust concentration may lower relative humidity at the surface, and this could potentially affect tropical cyclone development over the North Atlantic as been speculated in many papers.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kDdu3hbDMO"}],"key":"FP9X9tzMrd"}],"key":"CUqUeu6GhO"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Most relevant feature plane","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Pb1llz1ndW"}],"identifier":"most-relevant-feature-plane","label":"Most relevant feature plane","html_id":"most-relevant-feature-plane","implicit":true,"key":"RHXzyOZ8Mb"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"By associating each neuron to the feature with the maximum weight, we divide the map into distinct regions, where specific features are most important (high values).","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"SCiy7GKOAx"}],"key":"StF9g0JXtg"}],"key":"JSKMElE7eF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"Z = np.zeros((num, num))\nW = som.get_weights()\nplt.figure(figsize=(16, 10))\nfor i in np.arange(som._weights.shape[0]):\n    for j in np.arange(som._weights.shape[1]):\n        feature = np.argmax(W[i, j , :])\n        plt.plot([i+.5], [j+.5], color='C'+str(feature),\n                 marker='o', markersize=24)\n\nlegend_elements = [Patch(facecolor='C'+str(i),\n                         edgecolor='w',\n                         label=f) for i, f in enumerate(feature_names)]\n\nplt.legend(handles=legend_elements,\n           loc='center left',\n           bbox_to_anchor=(1, .7))     \nplt.xlim([0, num])\nplt.ylim([0, num])\nplt.show()","key":"bjn0QcxrSg"},{"type":"output","id":"-R1nuo93TPZTP7EXOJHac","data":[{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"2fa66937838feac8cf22324fc2e912d3","path":"/dust-cookbook/build/2fa66937838feac8cf22324fc2e912d3.png"},"text/plain":{"content":"<Figure size 2400x1500 with 1 Axes>","content_type":"text/plain"}}}],"key":"UIjBOWccvr"}],"key":"cGaJt25SkP"}],"key":"GE1NmYGPr2"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Principal Component Analysis","url":"/notebooks/pca","group":"Data Exploration"},"next":{"title":"Random Forest Regression","url":"/notebooks/random-forest","group":"Random Forest"}}},"domain":"http://localhost:3000"}